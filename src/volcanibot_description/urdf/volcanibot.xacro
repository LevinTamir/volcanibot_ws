<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="volcanibot">

  <xacro:arg name="is_ignition" default="true" />

  <!-- Include Gazebo plugins -->
  <xacro:include filename="$(find volcanibot_description)/urdf/volcanibot_gazebo.xacro" />

  <!-- Include ROS 2 Control plugins -->
  <xacro:include filename="$(find volcanibot_description)/urdf/volcanibot_ros2_control.xacro" />

  <!-- Colors -->
  <xacro:include filename="$(find volcanibot_description)/urdf/materials.xacro" />

  <!-- Define the world link -->
  <link name="base_footprint"/>

  <!-- Define a joint connecting world to base_link -->
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.9" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.000308432013766069 0.000824745609093291 -0.348795097773964" rpy="0 0 0" />
      <mass value="98.2206347258375" />
      <inertia ixx="8.02628327825717" ixy="0.00024350529649604" ixz="2.67248679783338E-13" iyy="8.04861649065601" iyz="-1.25831921649467E-12" izz="14.6198876609904" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://volcanibot_description/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://volcanibot_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <link name="rear_right_wheel_link">
    <inertial>
      <origin xyz="-0.002464 7.7174E-12 -1.0734E-12" rpy="0 0 0" />
      <mass value="19.568" />
      <inertia ixx="0.76858" ixy="-1.5351E-12" ixz="4.2467E-13" iyy="0.41546" iyz="-7.8249E-13" izz="0.41546" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://volcanibot_description/meshes/rear_right_wheel_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.26"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <origin xyz="0.9705 -0.5 -0.66" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rear_right_wheel_link" />
    <axis xyz="1 0 0" />
  </joint>

  <link name="rear_left_wheel_link">
    <inertial>
      <origin xyz="0.002464 -4.863E-12 6.0718E-12" rpy="0 0 0" />
      <mass value="19.568" />
      <inertia ixx="0.76858" ixy="-1.1522E-12" ixz="1.0999E-12" iyy="0.41546" iyz="-2.2866E-13" izz="0.41546" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://volcanibot_description/meshes/rear_left_wheel_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.26"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <origin xyz="-0.9705 -0.5 -0.66" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rear_left_wheel_link" />
    <axis xyz="1 0 0" />
  </joint>

  <link name="front_left_wheel_link">
    <inertial>
      <origin xyz="0.002464 3.0038E-12 7.1789E-12" rpy="0 0 0" />
      <mass value="19.568" />
      <inertia ixx="0.76858" ixy="4.1738E-13" ixz="1.5377E-12" iyy="0.41546" iyz="-5.1651E-13" izz="0.41546" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://volcanibot_description/meshes/front_left_wheel_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.26"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="-0.9705 0.5 -0.66" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="front_left_wheel_link" />
    <axis xyz="1 0 0" />
  </joint>

  <link name="front_right_wheel_link">
    <inertial>
      <origin xyz="-0.002464 7.518E-12 2.0106E-12" rpy="0 0 0" />
      <mass value="19.568" />
      <inertia ixx="0.76858" ixy="-1.5806E-12" ixz="-2.0336E-13" iyy="0.41546" iyz="-6.6262E-13" izz="0.41546" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://volcanibot_description/meshes/front_right_wheel_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.26"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.9705 0.5 -0.66" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="front_right_wheel_link" />
    <axis xyz="1 0 0" />
  </joint>

</robot>