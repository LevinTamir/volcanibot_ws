<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="volcanibot">

  <!-- Wheels -->
  <gazebo reference="rear_right_wheel_link">
    <mu1>1000000000000000.0</mu1>
    <mu2>1000000000000000.0</mu2>
    <kp>1000000000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="rear_left_wheel_link">
    <mu1>1000000000000000.0</mu1>
    <mu2>1000000000000000.0</mu2>
    <kp>1000000000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="front_right_wheel_link">
    <mu1>1000000000000000.0</mu1>
    <mu2>1000000000000000.0</mu2>
    <kp>1000000000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="front_left_wheel_link">
    <mu1>1000000000000000.0</mu1>
    <mu2>1000000000000000.0</mu2>
    <kp>1000000000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <!-- ROS 2 Control: Gazebo plugin loader, sim only -->
  <xacro:if value="$(arg use_sim)">
    <gazebo>
      <!-- ROS 2 Humble -->
      <xacro:if value="$(arg is_ignition)">
        <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
          <parameters>$(find volcanibot_controller)/config/volcanibot_controllers.yaml</parameters>
        </plugin>
      </xacro:if>

      <!-- ROS 2 Iron or above -->
      <xacro:unless value="$(arg is_ignition)">
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find volcanibot_controller)/config/volcanibot_controllers.yaml</parameters>
        </plugin>
      </xacro:unless>
    </gazebo>
  </xacro:if>

  <!-- Optional RGBD camera sensor -->
  <xacro:if value="$(arg camera)">
    <gazebo reference="camera_link">
      <sensor name="rgbd_camera" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.25</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
          </image>
          <clip>
            <near>0.3</near>
            <far>15</far>
          </clip>
          <optical_frame_id>camera_link_optical</optical_frame_id>
        </camera>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
        <topic>camera</topic>
        <gz_frame_id>camera_link</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- Optional Ouster Rev5 (OS2) lidar -->
  <xacro:if value="$(arg lidar)">
    <gazebo reference="os_sensor">
      <sensor name="ouster_os2" type="gpu_lidar">
        <pose>0 0 0.0435 0 0 0</pose>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <gz_frame_id>os_lidar</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>1024</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>128</samples>
              <resolution>1</resolution>
              <min_angle>-0.19635</min_angle>
              <max_angle>0.19635</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.4</min>
            <max>240.0</max>
            <resolution>0.03</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>
  </xacro:if>

</robot>
